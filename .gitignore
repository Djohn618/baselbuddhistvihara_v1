# .gitignore — Basel Buddhist Vihara

# ========================
# System Files
# ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ========================
# IDE & Editor
# ========================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.cursor/
.claude/

# ========================
# Secrets (never commit)
# ========================
*.env
.env
.env.local
.env.production

# ========================
# Logs
# ========================
*.log
logs/
npm-debug.log*

# ========================
# Dependencies (if ever needed)
# ========================
node_modules/
vendor/

# ========================
# Build Output (if ever needed)
# ========================
dist/
build/

# ========================
# Temp & Cache
# ========================
.cache/
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# ========================
# Source material (camera RAW, full-size edits, documents)
# ========================
# Kept locally in source-files/. Only the web versions in assets/images/
# belong in git and on Vercel.
source-files/
*.CR2
*.cr2

# ========================
# Sensitive Files
# ========================
*.pem
*.key
*.cert
*.p12
