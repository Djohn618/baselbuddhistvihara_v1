.gitignore für Basel Buddhist Vihara

# ========================
# System Files
# ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ========================
# IDE & Editor
# ========================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.cursor/
.claude/

# ========================
# PHP & Server
# ========================
# Config with sensitive data (email passwords etc.)
php/config.php
config.php
*.env
.env
.env.local
.env.production

# PHP error logs
php_errors.log
error_log

# ========================
# Logs
# ========================
*.log
logs/
npm-debug.log*

# ========================
# Dependencies (if ever needed)
# ========================
node_modules/
vendor/

# ========================
# Build Output (if ever needed)
# ========================
dist/
build/

# ========================
# Temp & Cache
# ========================
.cache/
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# ========================
# Source photos (camera RAW + full-size edits)
# ========================
# Only the web versions in assets/images/vihara/ belong in git and on Vercel.
assets/images/test_images/
assets/images/test_images_edited/
*.CR2
*.cr2

# ========================
# Sensitive Files
# ========================
*.pem
*.key
*.cert
*.p12

# Source of the donation QR code (the web page uses the recreated SVG/PNG)
assets/images/donation.pdf
